; Engine configuration file.
; Godot 4.3+. Edit through the editor where possible; core owns this file.

config_version=5

[application]

config/name="Touchline Football"
config/description="Realistic 2D top-down 11v11 football for mobile."
config/version="0.1.0"
run/main_scene="res://core/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://core/event_bus.gd"
GameSettings="*res://core/game_settings.gd"
Game="*res://core/game.gd"

[debug]

gdscript/warnings/unused_signal=0
gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.1, 0.3, 0.12, 1)
2d/snap/snap_2d_transforms_to_pixel=false
